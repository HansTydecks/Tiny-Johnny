---
import BaseLayout from '../layouts/BaseLayout.astro';
import SandboxApp from '../components/simulator/SandboxApp.svelte';
import { getExamples } from '../lib/content';
import { u } from '../lib/url';

const examples = await getExamples();
---

<BaseLayout title="Sandbox" description="Der vollständige Johnny-Simulator zum freien Ausprobieren.">
  <div class="page">
    <div class="intro">
      <div>
        <span class="eyebrow">Sandbox</span>
        <h1>Johnny – frei ausprobieren</h1>
        <p class="lead">
          Hier steht dir Johnny mit allen Funktionen zur Verfügung: Mikrobefehle von Hand, Makroschritte,
          Ausführen, eigene Befehle aufnehmen, Bonsai-Modus und Dateien laden/speichern. Dein Speicherinhalt wird
          automatisch in diesem Browser gemerkt.
        </p>
      </div>
      <div class="tips card">
        <b>Neu hier?</b>
        <p>Das <a href={u('tutorial')}>Tutorial</a> führt Schritt für Schritt durch alle Bauteile. Oder lade oben rechts ein <b>Beispiel</b>.</p>
      </div>
    </div>
    <SandboxApp client:load {examples} />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 28px 20px 0;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 24px;
    align-items: end;
    margin-bottom: 20px;
  }
  h1 {
    margin: 4px 0 8px;
  }
  .lead {
    color: var(--text-2);
    max-width: 760px;
    margin: 0;
  }
  .tips {
    padding: 14px 16px;
    font-size: 0.9rem;
  }
  .tips p {
    margin: 4px 0 0;
    color: var(--text-2);
  }
  @media (max-width: 860px) {
    .intro {
      grid-template-columns: 1fr;
    }
  }
</style>
