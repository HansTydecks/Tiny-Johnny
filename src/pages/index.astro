---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';

const kapitel = await getCollection('kapitel');
const levels = await getCollection('tutorial');
const aufgaben = await getCollection('aufgaben');

const steps = [
  {
    nr: 1,
    titel: 'Der Von-Neumann-Rechner',
    text: 'EVAS-Prinzip, Ein- und Ausgabe, Speichertechnik, Cache, Bus und CPU – mit Simulationen zum Ausprobieren.',
    href: u('von-neumann'),
    cta: 'Kapitel ansehen',
    farbe: 'mem',
    kind: 'kapitel',
    total: kapitel.length,
    einheit: 'Kapitel',
  },
  {
    nr: 2,
    titel: 'Johnny-Tutorial',
    text: 'Baue den Modellrechner Johnny Bauteil für Bauteil zusammen – in spielbaren Missionen mit Leitfragen.',
    href: u('tutorial'),
    cta: 'Missionen starten',
    farbe: 'cu',
    kind: 'level',
    total: levels.length,
    einheit: 'Missionen',
  },
  {
    nr: 3,
    titel: 'Aufgaben',
    text: 'Rechnen, Spiele, Informatik-Klassiker: Programme schreiben, lesen und reparieren – mit Tipps und automatischer Prüfung.',
    href: u('aufgaben'),
    cta: 'Aufgabe wählen',
    farbe: 'alu',
    kind: 'aufgaben',
    total: aufgaben.length,
    einheit: 'Aufgaben',
  },
  {
    nr: 4,
    titel: 'Sandbox',
    text: 'Johnny mit allen Funktionen: eigene Befehle, Bonsai-Modus, Dateien laden und speichern.',
    href: u('sandbox'),
    cta: 'Johnny öffnen',
    farbe: 'dbus',
    kind: '',
    total: 0,
    einheit: '',
  },
];
---

<BaseLayout title="Tiny Johnny">
  <section class="hero">
    <div class="hero-text">
      <span class="eyebrow">Prozessoren verstehen · Sekundarstufe II</span>
      <h1>Woher weiß der Computer eigentlich, <span class="grad">was er tun soll?</span></h1>
      <p class="lead">
        Ein Lernpfad vom <b>Von-Neumann-Rechner</b> bis zum Modellrechner <b>Johnny</b>. Du erkundest jedes Bauteil
        interaktiv, steuerst Johnny zuerst Mikrobefehl für Mikrobefehl von Hand und schreibst am Ende eigene Programme.
      </p>
      <div class="cta">
        <a class="btn primary big" href={u('von-neumann/ueberblick')}>Lernpfad starten →</a>
        <a class="btn big" href={u('tutorial')}>Direkt zu Johnny</a>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 420 340">
        <defs>
          <filter id="soft" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="6" stdDeviation="8" flood-opacity="0.12"></feDropShadow>
          </filter>
        </defs>
        <rect x="70" y="16" width="280" height="120" rx="22" class="cpu" filter="url(#soft)"></rect>
        <text x="210" y="40" class="t" text-anchor="middle">CPU</text>
        <rect x="90" y="52" width="115" height="66" rx="14" class="cu"></rect>
        <text x="147" y="82" class="tn" text-anchor="middle">Steuerwerk</text>
        <text x="147" y="102" class="tm" text-anchor="middle">pc · ins · mc</text>
        <rect x="215" y="52" width="115" height="66" rx="14" class="alu"></rect>
        <text x="272" y="82" class="tn" text-anchor="middle">Rechenwerk</text>
        <text x="272" y="102" class="tm" text-anchor="middle">acc = 00042</text>
        <g class="bus">
          <line x1="30" x2="390" y1="168" y2="168" class="ab"></line>
          <line x1="30" x2="390" y1="186" y2="186" class="db"></line>
          <line x1="210" x2="210" y1="136" y2="160" class="conn"></line>
          <line x1="80" x2="80" y1="194" y2="226" class="conn"></line>
          <line x1="210" x2="210" y1="194" y2="226" class="conn"></line>
          <line x1="340" x2="340" y1="194" y2="226" class="conn"></line>
        </g>
        <rect x="20" y="226" width="120" height="84" rx="16" class="io" filter="url(#soft)"></rect>
        <text x="80" y="274" class="tn" text-anchor="middle">Eingabe</text>
        <rect x="150" y="226" width="120" height="96" rx="16" class="mem" filter="url(#soft)"></rect>
        <text x="210" y="252" class="tn" text-anchor="middle">Speicher</text>
        <text x="210" y="274" class="tm" text-anchor="middle">000: TAKE 100</text>
        <text x="210" y="292" class="tm" text-anchor="middle">001: ADD 101</text>
        <text x="210" y="310" class="tm" text-anchor="middle">002: SAVE 102</text>
        <rect x="280" y="226" width="120" height="84" rx="16" class="io" filter="url(#soft)"></rect>
        <text x="340" y="274" class="tn" text-anchor="middle">Ausgabe</text>
      </svg>
    </div>
  </section>

  <section class="path">
    <h2>Dein Lernpfad</h2>
    <ol class="steps">
      {
        steps.map((s) => (
          <li class={`step c-${s.farbe}`}>
            <a href={s.href} class="step-card card">
              <span class="nr">{s.nr}</span>
              <b>{s.titel}</b>
              <span class="txt">{s.text}</span>
              {s.kind && (
                <span class="progress" data-count={s.kind} data-total={s.total}>
                  <span class="bar">
                    <span class="fill" />
                  </span>
                  <span class="lbl">
                    <span class="done-n">0</span> / {s.total} {s.einheit}
                  </span>
                </span>
              )}
              <span class="go">{s.cta} →</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="features">
    <div class="feature">
      <span class="ic c-accent">?</span>
      <b>Leitfragen</b>
      <p>Jedes Kapitel und jede Mission beginnt mit einer Frage – und endet damit, dass du sie beantworten kannst.</p>
    </div>
    <div class="feature">
      <span class="ic c-dbus">▶</span>
      <b>Zum Anfassen</b>
      <p>DRAM-Refresh, Festplattenkopf, Laser, Cache, Bus: Jede Idee lässt sich direkt im Browser ausprobieren.</p>
    </div>
    <div class="feature">
      <span class="ic c-alu">✓</span>
      <b>Sofort Rückmeldung</b>
      <p>Missionen und Aufgaben werden automatisch geprüft. Tipps gibt es in Stufen, die Musterlösung ganz zum Schluss.</p>
    </div>
    <div class="feature">
      <span class="ic c-mem">⌂</span>
      <b>Ohne Anmeldung</b>
      <p>Dein Fortschritt wird nur in diesem Browser gespeichert. Es werden keine Daten an einen Server geschickt.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { loadProgress, onProgress, type Progress } from '../lib/progress';
  const apply = (p: Progress) => {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const kind = el.dataset.count;
      const total = Number(el.dataset.total);
      const n =
        kind === 'kapitel'
          ? Object.values(p.kapitel).filter(Boolean).length
          : kind === 'level'
            ? Object.values(p.level).filter(Boolean).length
            : Object.values(p.aufgaben).filter((a) => a.geloest).length;
      const done = Math.min(n, total);
      el.querySelector('.done-n')!.textContent = String(done);
      (el.querySelector('.fill') as HTMLElement).style.width = `${(done / total) * 100}%`;
    });
  };
  apply(loadProgress());
  onProgress(apply);
</script>

<style>
  .hero {
    max-width: 1240px;
    margin: 0 auto;
    padding: 56px 20px 32px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 40px;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
    line-height: 1.08;
    margin: 12px 0 18px;
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--cu) 55%, var(--dbus));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--text-2);
    max-width: 640px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .btn.big {
    min-height: 50px;
    padding: 12px 22px;
    font-size: 1.02rem;
    border-radius: 12px;
  }
  .hero-art svg {
    width: 100%;
    height: auto;
  }
  .hero-art rect {
    stroke-width: 2;
  }
  .cpu {
    fill: var(--surface);
    stroke: var(--border);
  }
  .cu {
    fill: var(--cu-soft);
    stroke: var(--cu);
  }
  .alu {
    fill: var(--alu-soft);
    stroke: var(--alu);
  }
  .mem {
    fill: var(--mem-soft);
    stroke: var(--mem);
  }
  .io {
    fill: var(--io-soft);
    stroke: var(--io);
  }
  .t {
    font-weight: 800;
    font-size: 14px;
    fill: var(--text-2);
    letter-spacing: 0.1em;
  }
  .tn {
    font-weight: 700;
    font-size: 14px;
    fill: var(--text);
  }
  .tm {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--text-2);
  }
  .bus line {
    stroke-linecap: round;
  }
  .ab {
    stroke: var(--abus);
    stroke-width: 7;
    stroke-dasharray: 16 10;
    animation: flow 1.6s linear infinite;
  }
  .db {
    stroke: var(--dbus);
    stroke-width: 7;
    stroke-dasharray: 16 10;
    animation: flow 1.2s linear infinite reverse;
  }
  .conn {
    stroke: var(--border-strong);
    stroke-width: 5;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -52;
    }
  }
  .path {
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 20px;
  }
  .path h2 {
    margin-top: 0;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    counter-reset: step;
  }
  .step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 20px;
    color: var(--text);
    text-decoration: none;
    border-top: 4px solid var(--c);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .step-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-l);
    color: var(--text);
  }
  .nr {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--c-soft);
    color: var(--c);
    font-weight: 800;
  }
  .step-card b {
    font-size: 1.15rem;
  }
  .txt {
    color: var(--text-2);
    font-size: 0.93rem;
    flex: 1;
  }
  .progress {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bar {
    height: 6px;
    border-radius: 3px;
    background: var(--surface-3);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--c);
    transition: width 0.4s;
  }
  .lbl {
    font-size: 0.78rem;
    color: var(--text-3);
  }
  .go {
    font-weight: 700;
    color: var(--c);
    font-size: 0.92rem;
  }
  .features {
    max-width: 1240px;
    margin: 24px auto 0;
    padding: 24px 20px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .feature b {
    display: block;
    margin: 10px 0 4px;
  }
  .feature p {
    color: var(--text-2);
    font-size: 0.92rem;
    margin: 0;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--c-soft);
    color: var(--c);
    font-weight: 800;
  }
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 36px;
    }
    .hero-art {
      max-width: 460px;
    }
    .steps,
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .steps,
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
